.{
    // Package identity. The name is a Zig enum literal (no leading "zig").
    .name = .mahina,

    // Semantic version of the project itself.
    .version = "0.0.0",

    // Globally unique. The low half is a checksum of `.name`, so renaming the
    // package forces this to be re-derived — `zig build` refuses the stale value
    // and prints the correct one. Re-derived once for the lune -> mahina rename;
    // otherwise generated once and never changed.
    .fingerprint = 0xd9a5db7eaf66e979, // Changing this has security and trust implications.

    // The exact toolchain we pin to. `.zig-version` mirrors this for the
    // version-manager / CI guard in build.zig. Keep the two in sync.
    .minimum_zig_version = "0.17.0",

    // No third-party dependencies yet. A VM core deliberately writes its own
    // allocator and data structures (architecture principle #4).
    .dependencies = .{},

    // Files that constitute the package hash.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}
